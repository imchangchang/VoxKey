<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 采麦克风。hardened runtime 下缺这条，系统会直接拒掉音频输入，
         而且**不弹权限框**——现象就是「按了没反应」，非常难查。 -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Python 运行时（PyInstaller 的 bootloader、ctypes、objc）需要申请可写可执行内存 -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- 包里带的 libonnxruntime / libportaudio / libsherpa-onnx-* 是第三方 dylib，
         签名者不是我们。不开这个口子，hardened runtime 的库校验会在加载时拦下来。
         代价是降低了库校验强度——这是所有 Python + 原生推理库的打包都绕不开的一条。 -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
